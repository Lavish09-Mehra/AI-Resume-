# ============================================================
#  med_learn/backend  —  environment template
# ------------------------------------------------------------
#  1. Copy this file to   .env   (the real one is git-ignored)
#  2. Fill in real values
#  3. NEVER commit .env
#
#  DEPLOYING ON VERCEL: do not upload .env at all.
#  Add these in:  Project -> Settings -> Environment Variables
# ============================================================

# MongoDB connection string — user accounts only (never resumes)
MONGO_URL=mongodb://localhost:27017/ai-resume

# Long random string used to sign/verify JWTs
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
