# ============================================================
#  App-Backend  —  environment template
# ------------------------------------------------------------
#  1. Copy this file to   .env   (the real one is git-ignored)
#  2. Fill in real values
#  3. NEVER commit .env
#
#  DEPLOYING ON VERCEL: do not upload .env at all.
#  Add these in:  Project -> Settings -> Environment Variables
# ============================================================

# Groq API key used by AiLayer.js to score the resume
GROQ_KEY=your_groq_api_key_here

# MongoDB connection / API string
MONGO_API=your_mongodb_api_here
